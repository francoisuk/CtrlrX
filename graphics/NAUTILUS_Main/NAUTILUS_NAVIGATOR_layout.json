{
 "panel": "NAUTILUS_NAVIGATOR",
 "theme": "NAUTILUS_NAVIGATOR",
 "width": 1500,
 "height": 432,
 "units": "pixels du PNG 1x, origine en haut à gauche ; multiplier par 2 pour le PNG @2x",
 "background": "NAUTILUS_NAVIGATOR_fond.png",
 "background_2x": "NAUTILUS_NAVIGATOR_fond@2x.png",
 "background_notext": "NAUTILUS_NAVIGATOR_notext.png",
 "background_notext_2x": "NAUTILUS_NAVIGATOR_notext@2x.png",
 "backgrounds": "_fond : sans parties actives, libellés d'exemple gravés dans les afficheurs (FILTER FREQ…, SLIDER 1-8, GATE…) ; _notext : idem mais afficheurs vides, pour des libellés dynamiques (type display / menu : à écrire par l'éditeur, cf. text)",
 "types": {
  "button": "bouton (rectangle x, y, w, h)",
  "knob": "encodeur : rectangle = encodeur + couronne ; cx, cy, r = centre et rayon du bouton",
  "slider": "curseur vertical : rectangle = course du chapeau ; cx = axe, y0 / y1 = haut / bas de la fente",
  "display": "afficheur ; text = libellés d’exemple, dynamic = contenu variable",
  "menu": "afficheur à menu déroulant (▼)",
  "xy_pad": "pavé X-Y",
  "led": "voyant",
  "logo": "logo Kronoscopie"
 },
 "led_render": "Voyants (type led) : le fond ne porte que la lunette. Poser par-dessus, à x, y (17 x 17), l'image render.images.on ou .off selon l'état (ou la bande strip : 2 images verticales, éteint puis allumé ; @2x pour le PNG @2x), ou dessiner : cercle de lunette (bezel.r, fill, stroke) puis lampe de rayon lamp.r centrée en cx, cy, remplie d'un dégradé radial dont le centre (cx, cy) et le rayon (r) sont en fraction du carré de la lampe (2 x lamp.r), stops = [position 0-1, couleur]. state = état montré sur la maquette.",
